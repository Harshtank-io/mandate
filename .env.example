# Cloud saves and accounts (Supabase). Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API Keys. Both values are meant to be public and are safe in the browser.
# Never put a secret key (sb_secret_...) here. Without these values the game runs offline only.
# Vite reads .env.local, not this file, so keep your real values there (it is not committed).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: OAuth providers you have enabled in Supabase Auth, comma-separated (google, discord).
VITE_AUTH_PROVIDERS=
