{
  "name": "mandate",
  "private": true,
  "version": "0.1.0",
  "description": "Mandate - a persistent 3D living-world government simulation (MVP)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "calibrate": "vitest run --config vitest.calibrate.config.ts",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "preact": "10.29.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
